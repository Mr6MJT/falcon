#!/usr/bin/env python3
"""orvex-idor — IDOR differential engine (bundled in the worker image).

Two-session differential access check. Session credentials are provided via the environment
(ORVEX_IDOR_COOKIE_A / _B) as operator-owned sessions. Findings are ALWAYS candidate — the
tool flags a suspected IDOR for manual verification and never claims a confirmed access-control
break. Emits JSON lines for the `idor` stage.
"""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request

from packages.core.probes import idor_differential

USER_AGENT = "orvex-idor/1.0 (+authorized-testing)"
TIMEOUT = 10


def make_fetch(cookie: str):
    headers = {"User-Agent": USER_AGENT}
    if cookie:
        headers["Cookie"] = cookie

    def fetch(url: str, method: str = "GET"):
        req = urllib.request.Request(url, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:  # noqa: S310
                return r.status, {}, r.read(200_000).decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            return e.code, {}, (e.read(200_000).decode("utf-8", "replace") if e.fp else "")
        except Exception:  # noqa: BLE001
            return 0, {}, ""
    return fetch


def main(argv: list[str]) -> int:
    if "-h" in argv or "--help" in argv:
        print("usage: orvex-idor URL...  (sessions via ORVEX_IDOR_COOKIE_A/B)")
        return 0
    fetch_a = make_fetch(os.environ.get("ORVEX_IDOR_COOKIE_A", ""))
    fetch_b = make_fetch(os.environ.get("ORVEX_IDOR_COOKIE_B", ""))
    for url in argv:
        for finding in idor_differential(url, fetch_a, fetch_b):
            print(json.dumps(finding))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
