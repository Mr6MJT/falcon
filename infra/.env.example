# ---- Falcon deployment env (copy to infra/.env and fill in) ----
# Public domain (for auto-HTTPS). For a quick IP-only test, set FALCON_DOMAIN=:80
FALCON_DOMAIN=falcon.example.com

# The browser calls the API here. With the Caddy proxy it's your domain + /api.
NEXT_PUBLIC_API_BASE=https://falcon.example.com/api

# Postgres superuser (owner) password
POSTGRES_PASSWORD=change-me-owner-pass
# Non-owner application DB role password (RLS-enforced role the app runs as)
ORVEX_DB_PASSWORD=change-me-app-pass

# JWT signing secret (>= 32 chars) and secret-encryption key (base64 of 32 bytes:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
ORVEX_JWT_SECRET=change-me-to-a-long-random-32+char-secret
ORVEX_SECRET_KEY=base64-32-bytes-here

# First admin account (seeded once)
ORVEX_ADMIN_EMAIL=admin@yourcompany.com
ORVEX_ADMIN_PASSWORD=change-me-strong-admin-pass
